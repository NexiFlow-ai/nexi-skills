  "created_by": "nexus-platform",
  "created_at": "2026-09-17T00:00:00Z",
  "published_at": "2026-09-17T00:00:00Z",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "brief": {
        "type": "string"
      },
      "source_text": {
        "type": "string"
      },
      "tone": {
        "type": "string",
        "enum": [
          "neutral",
          "formal",
          "friendly",
          "direct"
        ]
      },
      "length": {
        "type": "string"
      },
      "audience": {
        "type": "string"
      },
      "format": {
        "type": "string",
        "enum": [
          "email",
          "memo",
          "announcement",
          "bullet_list",
          "plain"
        ]
      },
      "language": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "text": {
        "type": "string"
      },
      "changes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 8
      },
      "placeholders": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 20
      }
    },
    "required": [
      "text",
      "changes",
      "placeholders"
    ]
  },
  "examples": [
    {
      "title": "Rewrite a delay notice",
      "input": {
        "source_text": "…",
        "tone": "formal",
        "length": "shorter",
        "format": "email"
      },
      "expected_output": "{\"text\": \"Dear [recipient name], …\", \"changes\": [\"shortened to three paragraphs\"], \"placeholders\": [\"[recipient name]\"]}"
    }
  ]
}
