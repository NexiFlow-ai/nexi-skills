{
  "profile_id": "public-dev",
  "uri": "nexus://sandbox/profile/public-dev",
  "name": "Public dev sandbox",
  "description": "seed: docker_api-suitable dev profile. No network, baked packages only, 1 vCPU / 512 MiB / 120 s / 8 MiB output / 10 artifacts / 1 concurrent per run. Runs data up to confidential. Image nexus-sandbox-python:0.6 (digest logged by the manager, not pinned for dev).",
  "layer": "base",
  "runtimes": [
    "python"
  ],
  "network": {
    "policy": "none"
  },
  "packages": {
    "policy": "allowlist_only",
    "allowlist": [
      "numpy",
      "pandas",
      "scipy",
      "scikit-learn",
      "pyarrow",
      "openpyxl"
    ]
  },
  "limits": {
    "cpu_millicores": 1000,
    "memory_mb": 512,
    "timeout_s": 120,
    "max_output_mb": 8,
    "max_artifacts": 10,
    "max_concurrent_per_run": 1
  },
  "isolation": {
    "host_filesystem": "none",
    "credentials": "none",
    "input_datasets": "read_only",
    "artifact_dir": "writable",
    "ephemeral": true,
    "isolation_backend": "container-seccomp"
  },
  "classification_max": "confidential",
  "image": {
    "ref": "nexus-sandbox-python:0.6"
  },
  "audit": {
    "enabled": true,
    "retain_stdout_days": 30,
    "retain_code_days": 30
  },
  "version": "1.1.3",
  "created_at": "2026-09-10T00:00:00Z"
}
