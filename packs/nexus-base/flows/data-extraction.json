{
  "spec_version": "1.1",
  "workflow_id": "flw_tpl_data_extraction",
  "uri": "nexus://workflow/template/flw_tpl_data_extraction",
  "tenancy": {
    "enterprise_id": "nexus",
    "tenant_id": "platform"
  },
  "project_id": null,
  "name": "Data extraction",
  "description": "Sources → extract records into a target schema with provenance → validate against the schema → a table artifact; anything the schema could not be filled from is listed, never guessed.",
  "version": 1,
  "status": "published",
  "classification": "confidential",
  "template": {
    "is_template": true,
    "source_pack_uri": "nexus://core/pack/nexus-base",
    "source_template_version": "1.1.0"
  },
  "requires": {
    "models": [
      {
        "role": "extractor",
        "capabilities": [
          "structured_output"
        ]
      }
    ],
    "tools": [
      "nexus://tool/project.file_read",
      "nexus://tool/artifact.create_table"
    ]
  },
  "presentation": {
    "title": {
      "en": "Data extraction",
      "uk": "Видобування даних"
    },
    "stage_labels": [
      {
        "node_id": "read",
        "label": {
          "en": "Reading the sources",
          "uk": "Читаю джерела"
        }
      },
      {
        "node_id": "extract",
        "label": {
          "en": "Extracting records",
          "uk": "Видобуваю записи"
        }
      },
      {
        "node_id": "accept_gaps",
        "label": {
          "en": "Accept the gaps?",
          "uk": "Прийняти прогалини?"
        }
      },
      {
        "node_id": "save",
        "label": {
          "en": "Saving the table",
          "uk": "Зберігаю таблицю"
        }
      }
    ],
    "person_steps": [
      "accept_gaps"
    ],
    "receipt_fields": [
      {
        "key": "table",
        "label": {
          "en": "Table",
          "uk": "Таблиця"
        }
      }
    ],
    "result_kind": "artifacts"
  },
  "trigger": {
    "kind": "manual"
  },
  "inputs": [
    {
      "name": "document",
      "type": "file",
      "required": true
    },
    {
      "name": "target_schema",
      "type": "object",
      "required": true,
      "description": "JSON Schema of one record"
    }
  ],
  "outputs": [
    {
      "name": "table",
      "type": "resource_uri"
    }
  ],
  "nodes": [
    {
      "id": "trigger",
      "kind": "trigger",
      "label": "Start"
    },
    {
      "id": "read",
      "kind": "tool",
      "label": "Read the sources",
      "timeout_s": 120,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "read"
      },
      "tool": {
        "tool_uri": "nexus://tool/project.file_read",
        "operation": "read",
        "mutating": false
      },
      "input_mapping": {
        "attachment": "$.inputs.document"
      }
    },
    {
      "id": "extract",
      "kind": "agent",
      "label": "Extract records",
      "timeout_s": 600,
      "policy": {
        "pep_action": "invoke",
        "purpose": "extraction"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_analyst",
        "context_scope": "project",
        "skill_uris": [
          "nexus://skill/skl_extract_structured_data"
        ],
        "output_schema": {
          "type": "object",
          "required": [
            "records",
            "missing",
            "confidence"
          ],
          "properties": {
            "records": {
              "type": "array"
            },
            "missing": {
              "type": "array"
            },
            "confidence": {
              "type": "array"
            }
          }
        }
      },
      "input_mapping": {
        "text": "$.node.read.output.text",
        "target_schema": "$.inputs.target_schema"
      }
    },
    {
      "id": "complete",
      "kind": "condition",
      "label": "Nothing missing?",
      "condition": {
        "language": "nexus-expr-v1",
        "source": "$.node.extract.output.missing == []"
      }
    },
    {
      "id": "accept_gaps",
      "kind": "approval",
      "label": "Accept the gaps",
      "timeout_s": 259200,
      "approval": {
        "approver": {
          "relation": "editor"
        },
        "title_template": "Extraction of {{inputs.document}} has missing fields — accept and save anyway?",
        "on_timeout": "fail"
      }
    },
    {
      "id": "save",
      "kind": "tool",
      "label": "Save the table",
      "timeout_s": 120,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "save"
      },
      "tool": {
        "tool_uri": "nexus://tool/artifact.create_table",
        "operation": "create",
        "mutating": true
      },
      "idempotency": {
        "key_template": "data-extraction:{{run_id}}",
        "dedupe_window_s": 86400
      },
      "input_mapping": {
        "title": "$.inputs.document",
        "rows": "$.node.extract.output.records"
      }
    },
    {
      "id": "notify",
      "kind": "notify",
      "label": "Post to the thread",
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "initial_delay_s": 5,
        "max_delay_s": 60
      },
      "idempotency": {
        "key_template": "notify:{{run_id}}",
        "dedupe_window_s": 86400
      },
      "notify": {
        "channel_uri": "nexus://chat/thread/{{run.thread_id}}",
        "template": "Extracted {{node.extract.output.records | length}} records from {{inputs.document}}.",
        "channel": "thread"
      }
    },
    {
      "id": "end",
      "kind": "end",
      "label": "Done"
    }
  ],
  "edges": [
    {
      "id": "e-trigger-read",
      "source": "trigger",
      "target": "read"
    },
    {
      "id": "e-read-extract",
      "source": "read",
      "target": "extract"
    },
    {
      "id": "e-extract-complete",
      "source": "extract",
      "target": "complete"
    },
    {
      "id": "e-complete-save-true",
      "source": "complete",
      "target": "save",
      "when": "true"
    },
    {
      "id": "e-complete-accept_gaps-false",
      "source": "complete",
      "target": "accept_gaps",
      "when": "false"
    },
    {
      "id": "e-accept_gaps-save-approved",
      "source": "accept_gaps",
      "target": "save",
      "when": "approved"
    },
    {
      "id": "e-accept_gaps-end-rejected",
      "source": "accept_gaps",
      "target": "end",
      "when": "rejected"
    },
    {
      "id": "e-save-notify",
      "source": "save",
      "target": "notify"
    },
    {
      "id": "e-notify-end",
      "source": "notify",
      "target": "end"
    }
  ],
  "policy": {
    "approval_for_external_writes": false,
    "max_run_duration_s": 604800,
    "allowed_tool_uris": [
      "nexus://tool/project.file_read",
      "nexus://tool/artifact.create_table"
    ],
    "run_as": "initiator",
    "sensitive_outputs": [],
    "max_loop_depth": 1,
    "sandbox_profile_uri": "nexus://sandbox/profile/public-dev"
  },
  "layout": {
    "positions": {
      "trigger": {
        "x": 200,
        "y": 0
      },
      "read": {
        "x": 200,
        "y": 116
      },
      "extract": {
        "x": 200,
        "y": 232
      },
      "complete": {
        "x": 200,
        "y": 348
      },
      "accept_gaps": {
        "x": 200,
        "y": 464
      },
      "save": {
        "x": 200,
        "y": 580
      },
      "notify": {
        "x": 200,
        "y": 696
      },
      "end": {
        "x": 200,
        "y": 812
      }
    }
  },
  "governance": {
    "state": "approved",
    "reviewed_at": "2026-09-17T00:00:00Z"
  },
  "security_review": {
    "state": "not_required"
  },
  "created_by": "pack:nexus-base",
  "created_at": "2026-09-17T00:00:00Z",
  "published_at": "2026-09-17T00:00:00Z"
}
