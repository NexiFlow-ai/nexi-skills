{
  "spec_version": "1.1",
  "workflow_id": "flw_tpl_weekly_digest",
  "uri": "nexus://workflow/template/flw_tpl_weekly_digest",
  "tenancy": {
    "enterprise_id": "nexus",
    "tenant_id": "platform"
  },
  "project_id": null,
  "name": "Weekly digest",
  "description": "Every Monday 08:00: search the Project for the week's activity, summarize it for an executive reader, save the digest as a document and post it to the thread. Read-only except the artifact.",
  "version": 1,
  "status": "published",
  "classification": "confidential",
  "template": {
    "is_template": true,
    "source_pack_uri": "nexus://core/pack/nexus-base",
    "source_template_version": "1.0.0"
  },
  "requires": {
    "models": [
      {
        "role": "chat"
      }
    ],
    "tools": [
      "nexus://tool/project.search",
      "nexus://tool/artifact.create_document"
    ]
  },
  "trigger": {
    "kind": "schedule",
    "schedule_cron": "0 8 * * 1",
    "schedule_timezone": "Europe/Kyiv"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "digest",
      "type": "resource_uri"
    }
  ],
  "nodes": [
    {
      "id": "trigger",
      "kind": "trigger",
      "label": "Start"
    },
    {
      "id": "search",
      "kind": "tool",
      "label": "Collect the week's activity",
      "timeout_s": 120,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "search"
      },
      "tool": {
        "tool_uri": "nexus://tool/project.search",
        "operation": "search",
        "mutating": false
      },
      "input_mapping": {
        "query": "'activity since last week'",
        "since": "$.run.scheduled_for"
      }
    },
    {
      "id": "summarize",
      "kind": "agent",
      "label": "Write the digest",
      "timeout_s": 300,
      "policy": {
        "pep_action": "invoke",
        "purpose": "digest"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_writer",
        "context_scope": "project",
        "skill_uris": [
          "nexus://skill/skl_summarize_sources"
        ],
        "output_schema": {
          "type": "object",
          "required": [
            "summary",
            "key_points"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "key_points": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "input_mapping": {
        "text": "$.node.search.output.results"
      }
    },
    {
      "id": "save",
      "kind": "tool",
      "label": "Save the digest",
      "timeout_s": 120,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "save"
      },
      "tool": {
        "tool_uri": "nexus://tool/artifact.create_document",
        "operation": "create",
        "mutating": true
      },
      "idempotency": {
        "key_template": "weekly-digest:{{run_id}}",
        "dedupe_window_s": 86400
      },
      "input_mapping": {
        "title": "'Weekly digest'",
        "body": "$.node.summarize.output.summary"
      }
    },
    {
      "id": "notify",
      "kind": "notify",
      "label": "Post to the thread",
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "initial_delay_s": 5,
        "max_delay_s": 60
      },
      "idempotency": {
        "key_template": "notify:{{run_id}}",
        "dedupe_window_s": 86400
      },
      "notify": {
        "channel_uri": "nexus://chat/thread/{{run.thread_id}}",
        "template": "Weekly digest: {{node.summarize.output.summary}}",
        "channel": "thread"
      }
    },
    {
      "id": "end",
      "kind": "end",
      "label": "Done"
    }
  ],
  "edges": [
    {
      "id": "e-trigger-search",
      "source": "trigger",
      "target": "search"
    },
    {
      "id": "e-search-summarize",
      "source": "search",
      "target": "summarize"
    },
    {
      "id": "e-summarize-save",
      "source": "summarize",
      "target": "save"
    },
    {
      "id": "e-save-notify",
      "source": "save",
      "target": "notify"
    },
    {
      "id": "e-notify-end",
      "source": "notify",
      "target": "end"
    }
  ],
  "policy": {
    "approval_for_external_writes": false,
    "max_run_duration_s": 3600,
    "allowed_tool_uris": [
      "nexus://tool/project.search",
      "nexus://tool/artifact.create_document"
    ],
    "run_as": "initiator",
    "sensitive_outputs": [],
    "max_loop_depth": 1,
    "sandbox_profile_uri": "nexus://sandbox/profile/public-dev"
  },
  "layout": {
    "positions": {
      "trigger": {
        "x": 200,
        "y": 0
      },
      "search": {
        "x": 200,
        "y": 116
      },
      "summarize": {
        "x": 200,
        "y": 232
      },
      "save": {
        "x": 200,
        "y": 348
      },
      "notify": {
        "x": 200,
        "y": 464
      },
      "end": {
        "x": 200,
        "y": 580
      }
    }
  },
  "governance": {
    "state": "approved",
    "reviewed_at": "2026-09-17T00:00:00Z"
  },
  "security_review": {
    "state": "not_required"
  },
  "created_by": "pack:nexus-base",
  "created_at": "2026-09-17T00:00:00Z",
  "published_at": "2026-09-17T00:00:00Z"
}
