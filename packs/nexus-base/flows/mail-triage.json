{
  "spec_version": "1.1",
  "workflow_id": "flw_tpl_mail_triage",
  "uri": "nexus://workflow/template/flw_tpl_mail_triage",
  "tenancy": {
    "enterprise_id": "nexus",
    "tenant_id": "platform"
  },
  "project_id": null,
  "name": "Mail triage",
  "description": "Every Monday 08:00: read the past week's mail through the person's Gmail connection (read-only), name what needs their attention, draft replies as a document and post the summary to the thread. Nothing is sent, moved or deleted — the Gmail tools are read-only and the Flow runs as the person who scheduled it.",
  "version": 1,
  "status": "published",
  "classification": "confidential",
  "template": {
    "is_template": true,
    "source_pack_uri": "nexus://core/pack/nexus-base",
    "source_template_version": "1.0.0",
    "parameters": [
      {
        "name": "focus",
        "type": "string",
        "required": false,
        "description": "What to lead with, in the person's words — projects, people, topics (e.g. 'Orion and Atlas'). Empty means the whole inbox."
      },
      {
        "name": "query",
        "type": "string",
        "required": false,
        "description": "The Gmail search the Flow starts from. Default: mail addressed to the person in the past 7 days, excluding drafts and mail they sent."
      }
    ]
  },
  "requires": {
    "models": [
      {
        "role": "reasoner"
      }
    ],
    "tools": [
      "nexus://tool/gmail.search_messages",
      "nexus://tool/gmail.read_thread",
      "nexus://tool/artifact.create_document"
    ]
  },
  "trigger": {
    "kind": "schedule",
    "schedule_cron": "0 8 * * 1",
    "schedule_timezone": "Europe/Kyiv"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "triage",
      "type": "resource_uri"
    }
  ],
  "nodes": [
    {
      "id": "trigger",
      "kind": "trigger",
      "label": "Start"
    },
    {
      "id": "search",
      "kind": "tool",
      "label": "Search last week's mail",
      "timeout_s": 120,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "search"
      },
      "tool": {
        "tool_uri": "nexus://tool/gmail.search_messages",
        "operation": "search",
        "mutating": false
      },
      "input_mapping": {
        "q": "'{{param.query}}' or 'to:me newer_than:7d -in:sent -in:drafts'",
        "max_results": "100"
      }
    },
    {
      "id": "read",
      "kind": "tool",
      "label": "Read the threads that need it",
      "timeout_s": 300,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "read"
      },
      "tool": {
        "tool_uri": "nexus://tool/gmail.read_thread",
        "operation": "read",
        "mutating": false
      },
      "input_mapping": {
        "thread_ids": "$.node.search.output.thread_ids",
        "format": "'metadata'"
      }
    },
    {
      "id": "triage",
      "kind": "agent",
      "label": "Triage and draft replies",
      "timeout_s": 600,
      "policy": {
        "pep_action": "invoke",
        "purpose": "triage"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_general",
        "context_scope": "project",
        "skill_uris": [
          "nexus://skill/skl_mail_triage"
        ],
        "output_schema": {
          "type": "object",
          "required": [
            "attention",
            "summary"
          ],
          "properties": {
            "attention": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "drafts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "fyi": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "summary": {
              "type": "string"
            }
          }
        }
      },
      "input_mapping": {
        "messages": "$.node.read.output.messages",
        "since": "$.run.scheduled_for",
        "focus": "'{{param.focus}}'",
        "me": "$.run.initiator.email"
      }
    },
    {
      "id": "save",
      "kind": "tool",
      "label": "Save the triage and the drafts",
      "timeout_s": 120,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "save"
      },
      "tool": {
        "tool_uri": "nexus://tool/artifact.create_document",
        "operation": "create",
        "mutating": true
      },
      "idempotency": {
        "key_template": "mail-triage:{{run_id}}",
        "dedupe_window_s": 86400
      },
      "input_mapping": {
        "title": "'Mail triage — week of {{run.scheduled_for}}'",
        "body": "$.node.triage.output"
      }
    },
    {
      "id": "notify",
      "kind": "notify",
      "label": "Post the summary to the thread",
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "initial_delay_s": 5,
        "max_delay_s": 60
      },
      "idempotency": {
        "key_template": "notify:{{run_id}}",
        "dedupe_window_s": 86400
      },
      "notify": {
        "channel_uri": "nexus://chat/thread/{{run.thread_id}}",
        "template": "Mail triage: {{node.triage.output.summary}}",
        "channel": "thread"
      }
    },
    {
      "id": "end",
      "kind": "end",
      "label": "Done"
    }
  ],
  "edges": [
    {
      "id": "e-trigger-search",
      "source": "trigger",
      "target": "search"
    },
    {
      "id": "e-search-read",
      "source": "search",
      "target": "read"
    },
    {
      "id": "e-read-triage",
      "source": "read",
      "target": "triage"
    },
    {
      "id": "e-triage-save",
      "source": "triage",
      "target": "save"
    },
    {
      "id": "e-save-notify",
      "source": "save",
      "target": "notify"
    },
    {
      "id": "e-notify-end",
      "source": "notify",
      "target": "end"
    }
  ],
  "policy": {
    "approval_for_external_writes": false,
    "max_run_duration_s": 3600,
    "allowed_tool_uris": [
      "nexus://tool/gmail.search_messages",
      "nexus://tool/gmail.read_thread",
      "nexus://tool/artifact.create_document"
    ],
    "run_as": "initiator",
    "sensitive_outputs": [
      "triage"
    ],
    "budget": {
      "max_tokens": 40000,
      "max_tool_calls": 40
    },
    "max_loop_depth": 1,
    "sandbox_profile_uri": "nexus://sandbox/profile/public-dev"
  },
  "layout": {
    "positions": {
      "trigger": {
        "x": 200,
        "y": 0
      },
      "search": {
        "x": 200,
        "y": 116
      },
      "read": {
        "x": 200,
        "y": 232
      },
      "triage": {
        "x": 200,
        "y": 348
      },
      "save": {
        "x": 200,
        "y": 464
      },
      "notify": {
        "x": 200,
        "y": 580
      },
      "end": {
        "x": 200,
        "y": 696
      }
    }
  },
  "governance": {
    "state": "approved",
    "reviewed_at": "2026-09-25T00:00:00Z"
  },
  "security_review": {
    "state": "not_required"
  },
  "created_by": "pack:nexus-base",
  "created_at": "2026-09-25T00:00:00Z",
  "published_at": "2026-09-25T00:00:00Z"
}
