  "trigger": {
    "kind": "event",
    "event_subject": "nexus.core.governance.event.v1",
    "event_filter": {
      "language": "nexus-expr-v1",
      "source": "$.event.payload.kind in ['member.joined', 'connection.credential_set', 'pack.installed']"
    }
  },
