    {
      "name": "result",
      "type": "object"
    }
  ],
  "nodes": [
    {
      "id": "trigger",
      "kind": "trigger",
      "label": "Start"
    },
    {
      "id": "facts",
      "kind": "transform",
      "label": "What happened",
      "description": "The one fact of the step as the event carries it (`shared/governance.py`: identifiers and flags, a display name only where NexCore put one — never an e-mail). A field the payload does not carry is null and the Guide drops its words.",
      "transform": {
        "mapping": {
          "kind": "$.event.payload.kind",
          "subject_display": "$.event.payload.subject_display",
          "role": "$.event.payload.role",
          "provider": "$.event.payload.provider",
          "pack_name": "$.event.payload.pack_name"
        }
      }
    },
    {
      "id": "person",
      "kind": "transform",
      "label": "Who the line is for",
      "description": "The Owner — the run's own initiator (`run_as: flow_owner`). A governance event names no person and no locale (`shared/governance.py`: identifiers and flags only); the Guide greets without a name, in English.",
      "transform": {
        "mapping": {
          "first_name": "null",
          "locale": "null"
        }
      }
    },
    {
      "id": "organization",
      "kind": "transform",
      "label": "The organization",
