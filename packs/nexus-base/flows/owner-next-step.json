        "mapping": {
          "name": "null",
          "role": "'owner'",
          "owner_display_name": "null"
        }
      },
      "description": "A governance event does not carry the organization's name; the Guide drops it from the line rather than guess."
    },
    {
      "id": "is-invite",
      "kind": "condition",
      "label": "A member joined?",
      "description": "`payload.kind == 'member.joined'` — the engine decides which next line this is, never the model.",
