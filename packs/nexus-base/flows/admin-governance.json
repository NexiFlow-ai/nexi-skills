{
  "spec_version": "1.1",
  "workflow_id": "flw_tpl_admin_governance",
  "uri": "nexus://workflow/template/flw_tpl_admin_governance",
  "tenancy": {
    "enterprise_id": "nexus",
    "tenant_id": "platform"
  },
  "project_id": null,
  "name": "Admin governance",
  "description": "every governance event of the organization (a person joined, an invitation or a join request was created, a member was suspended or deactivated, the tool policy changed, a model or a connection credential was registered, a pack was installed) starts one run as the Owner. The Governance agent applies the *assess governance risk* skill and proposes risks; the run records them as a *Governance risk register* table in the project (status proposed, provenance = the audit row); when one of the four escalation rules fires, the Owner is asked to confirm in NexTasks. The flow never applies or reverts anything — it informs. Installed enabled for the Owner.",
  "version": 2,
  "status": "published",
  "classification": "confidential",
  "template": {
    "is_template": true,
    "source_pack_uri": "nexus://core/pack/nexus-base",
    "source_template_version": "1.1.0"
  },
  "requires": {
    "models": [
      {
        "role": "classifier",
        "capabilities": [
          "structured_output"
        ]
      }
    ],
    "tools": [
      "nexus://tool/artifact.create_table"
    ]
  },
  "trigger": {
    "kind": "event",
    "event_subject": "nexus.core.governance.event.v1"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "result",
      "type": "object"
    }
  ],
  "nodes": [
    {
      "id": "trigger",
      "kind": "trigger",
      "label": "Governance event"
    },
    {
      "id": "assess",
      "kind": "agent",
      "label": "Assess the risk",
      "timeout_s": 300,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "governance_assessment"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_governance",
        "context_scope": "project",
        "skill_uris": [
          "nexus://skill/skl_assess_governance_risk"
        ]
      },
      "input_mapping": {
        "event": "$.event.payload"
      },
      "description": "The skill's own output_schema is the contract: summary · risk_count · highest_severity · register (proposed rows only)."
    },
    {
      "id": "record",
      "kind": "tool",
      "label": "Record the risk register",
      "timeout_s": 120,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "record"
      },
      "tool": {
        "tool_uri": "nexus://tool/artifact.create_table",
        "operation": "create",
        "mutating": true
      },
      "idempotency": {
        "key_template": "governance-register:{{run_id}}",
        "dedupe_window_s": 86400
      },
      "input_mapping": {
        "title": "'Governance risk register'",
        "spec": "$.node.assess.output.register"
      },
      "description": "One table artifact per run in the project; every row is a proposed risk with its provenance."
    },
    {
      "id": "escalate",
      "kind": "condition",
      "label": "Does a rule fire?",
      "condition": {
        "language": "nexus-expr-v1",
        "source": "($.event.payload.kind == 'member.joined' and $.event.payload.clearance in ['secret', 'top_secret']) or ($.event.payload.kind == 'tool_policy.changed' and $.event.payload.opened_count > 0) or ($.event.payload.kind == 'model.registered' and $.event.payload.provider_kind == 'cloud') or ($.event.payload.kind in ['member.suspended', 'member.deactivated'] and $.event.payload.actor_is_owner == false)"
      },
      "description": "Q-F-2: a join with clearance secret+ · a tool opened beyond the base allow-list · a cloud model registered · a suspension / deactivation done by an Admin who is not the Owner."
    },
    {
      "id": "confirm",
      "kind": "approval",
      "label": "Owner confirms",
      "timeout_s": 259200,
      "approval": {
        "approver": {
          "relation": "owner"
        },
        "title_template": "Governance: {{event.payload.kind}} — {{node.assess.output.summary}}",
        "on_timeout": "fail"
      }
    },
    {
      "id": "end",
      "kind": "end",
      "label": "Done",
      "input_mapping": {
        "result": "$.node.assess.output",
        "register": "$.node.record.output",
        "confirmation": "$.node.confirm.output"
      },
      "description": "`result` is the assessment; `register` the artifact reference; `confirmation` the Owner's decision when a rule fired."
    }
  ],
  "edges": [
    {
      "id": "e-trigger-assess",
      "source": "trigger",
      "target": "assess"
    },
    {
      "id": "e-assess-record",
      "source": "assess",
      "target": "record"
    },
    {
      "id": "e-record-escalate",
      "source": "record",
      "target": "escalate"
    },
    {
      "id": "e-escalate-confirm-true",
      "source": "escalate",
      "target": "confirm",
      "when": "true",
      "label": "rule fired"
    },
    {
      "id": "e-escalate-end-false",
      "source": "escalate",
      "target": "end",
      "when": "false"
    },
    {
      "id": "e-confirm-end-approved",
      "source": "confirm",
      "target": "end",
      "when": "approved"
    },
    {
      "id": "e-confirm-end-rejected",
      "source": "confirm",
      "target": "end",
      "when": "rejected"
    }
  ],
  "policy": {
    "approval_for_external_writes": false,
    "max_run_duration_s": 259200,
    "allowed_tool_uris": [
      "nexus://tool/artifact.create_table"
    ],
    "run_as": "initiator",
    "sensitive_outputs": [],
    "max_loop_depth": 1,
    "sandbox_profile_uri": "nexus://sandbox/profile/public-dev"
  },
  "layout": {
    "positions": {
      "trigger": {
        "x": 200,
        "y": 0
      },
      "assess": {
        "x": 200,
        "y": 116
      },
      "record": {
        "x": 200,
        "y": 232
      },
      "escalate": {
        "x": 200,
        "y": 348
      },
      "confirm": {
        "x": 200,
        "y": 464
      },
      "end": {
        "x": 200,
        "y": 580
      }
    }
  },
  "governance": {
    "state": "approved",
    "reviewed_at": "2026-09-19T00:00:00Z"
  },
  "security_review": {
    "state": "not_required"
  },
  "created_by": "pack:nexus-base",
  "created_at": "2026-09-17T00:00:00Z",
  "published_at": "2026-09-19T00:00:00Z"
}
