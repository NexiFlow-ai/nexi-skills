      "target": "hello"
    },
    {
      "id": "e-hello-end",
      "source": "hello",
      "target": "end"
    }
  ],
  "policy": {
    "approval_for_external_writes": false,
    "max_run_duration_s": 900,
    "allowed_tool_uris": [
