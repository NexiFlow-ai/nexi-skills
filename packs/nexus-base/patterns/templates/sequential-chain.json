  "nodes": [
    {
      "id": "trigger",
      "kind": "trigger",
      "label": "Start"
    },
    {
      "id": "step_a",
      "kind": "agent",
      "label": "Step A",
      "timeout_s": 300,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "analysis"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_general",
        "context_scope": "project",
        "inference": {
          "role": "reasoner"
        }
      },
      "input_mapping": {
        "request": "$.inputs.request"
      },
      "description": "First step, e.g. extract."
    },
    {
      "id": "step_b",
      "kind": "agent",
      "label": "Step B",
      "timeout_s": 300,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "analysis"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_general",
        "context_scope": "project",
        "inference": {
          "role": "reasoner"
        }
      },
      "input_mapping": {
        "previous": "$.node.step_a.output"
      },
      "description": "Second step, e.g. validate."
    },
    {
      "id": "step_c",
      "kind": "agent",
      "label": "Step C",
      "timeout_s": 300,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "analysis"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_writer",
        "context_scope": "project",
        "inference": {
          "role": "summarizer"
        }
      },
      "input_mapping": {
        "previous": "$.node.step_b.output"
      },
      "description": "Last step, e.g. format the result."
    },
    {
      "id": "end",
      "kind": "end",
      "label": "Done",
      "input_mapping": {
        "result": "$.node.step_c.output",
        "step_a": "$.node.step_a.output",
        "step_b": "$.node.step_b.output"
      },
      "description": "What the run returns: `result` is the substantive answer; the other keys are the steps' outputs for review and debugging."
    }
  ],
  "edges": [
