          "en": "Step A",
          "uk": "Крок A"
        }
      },
      {
        "node_id": "step_b",
        "label": {
          "en": "Step B",
          "uk": "Крок B"
        }
      },
      {
        "node_id": "step_c",
        "label": {
          "en": "Step C",
          "uk": "Крок C"
        }
