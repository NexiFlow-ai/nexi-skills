{
  "spec_version": "1.1",
  "workflow_id": "flw_tpl_model_cascade",
  "uri": "nexus://workflow/template/model-cascade",
  "tenancy": {
    "enterprise_id": "pack",
    "tenant_id": "pack"
  },
  "project_id": null,
  "name": "Model cascade",
  "description": "Try the smallest qualified model first; escalate to a stronger one only when the check says the result is not good enough.",
  "version": 1,
  "status": "published",
  "classification": "confidential",
  "template": {
    "is_template": true,
    "source_pack_uri": "nexus://core/pack/nexus-base",
    "source_template_version": "1.1.0"
  },
  "requires": {},
  "presentation": {
    "title": {
      "en": "Model cascade",
      "uk": "Каскад моделей"
    },
    "stage_labels": [
      {
        "node_id": "first",
        "label": {
          "en": "Small model first",
          "uk": "Спочатку мала модель"
        }
      },
      {
        "node_id": "second",
        "label": {
          "en": "Stronger model",
          "uk": "Сильніша модель"
        }
      }
    ],
    "receipt_fields": [
      {
        "key": "result",
        "label": {
          "en": "Result",
          "uk": "Результат"
        }
      }
    ],
    "result_kind": "answer"
  },
  "trigger": {
    "kind": "manual"
  },
  "inputs": [
    {
      "name": "request",
      "type": "string",
      "required": true,
      "description": "What the flow works on"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "object"
    }
  ],
  "nodes": [
    {
      "id": "trigger",
      "kind": "trigger",
      "label": "Start"
    },
    {
      "id": "first",
      "kind": "agent",
      "label": "Small model first",
      "timeout_s": 300,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "analysis"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_general",
        "context_scope": "project",
        "inference": {
          "role": "chat_fast",
          "strategy": "cheapest_qualified",
          "max_tier": 1
        },
        "output_schema": {
          "type": "object",
          "required": [
            "answer",
            "confidence"
          ],
          "properties": {
            "answer": {},
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "input_mapping": {
        "request": "$.inputs.request"
      },
      "description": "Tier ≤ 1 (local / small). The agent reports its own confidence; the check below decides, not the model."
    },
    {
      "id": "check_first",
      "kind": "evaluator",
      "label": "Good enough?",
      "timeout_s": 30,
      "evaluator": {
        "kind": "deterministic",
        "criteria_source": "inline",
        "criteria": [
          {
            "metric": "confidence",
            "operator": "gte",
            "value": 0.85
          }
        ],
        "metrics_path": "$.node.first.output"
      }
    },
    {
      "id": "sufficient",
      "kind": "condition",
      "label": "Sufficient?",
      "condition": {
        "language": "nexus-expr-v1",
        "source": "$.node.check_first.output.passed == true"
      }
    },
    {
      "id": "second",
      "kind": "agent",
      "label": "Stronger model",
      "timeout_s": 300,
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_s": 5
      },
      "policy": {
        "pep_action": "invoke",
        "purpose": "analysis"
      },
      "agent": {
        "agent_uri": "nexus://agent/agt_general",
        "context_scope": "project",
        "inference": {
          "role": "reasoner",
          "strategy": "quality_first"
        }
      },
      "input_mapping": {
        "request": "$.inputs.request",
        "first_attempt": "$.node.first.output"
      },
      "description": "Only runs when the first result was not sufficient."
    },
    {
      "id": "check_second",
      "kind": "evaluator",
      "label": "Check again",
      "timeout_s": 30,
      "evaluator": {
        "kind": "deterministic",
        "criteria_source": "inline",
        "criteria": [
          {
            "metric": "confidence",
            "operator": "gte",
            "value": 0.85
          }
        ],
        "metrics_path": "$.node.second.output"
      }
    },
    {
      "id": "end",
      "kind": "end",
      "label": "Done",
      "input_mapping": {
        "result": "$.node.first.output",
        "first_verdict": "$.node.check_first.output",
        "escalated": "$.node.second.output",
        "escalated_verdict": "$.node.check_second.output"
      },
      "description": "The run's result is the first model's answer; `escalated` is the second model's answer when the first was not sufficient (null otherwise)."
    }
  ],
  "edges": [
    {
      "id": "e-trigger-first",
      "source": "trigger",
      "target": "first"
    },
    {
      "id": "e-first-check_first",
      "source": "first",
      "target": "check_first"
    },
    {
      "id": "e-check_first-sufficient",
      "source": "check_first",
      "target": "sufficient"
    },
    {
      "id": "e-sufficient-end-true",
      "source": "sufficient",
      "target": "end",
      "when": "true",
      "label": "yes"
    },
    {
      "id": "e-sufficient-second-false",
      "source": "sufficient",
      "target": "second",
      "when": "false",
      "label": "escalate"
    },
    {
      "id": "e-second-check_second",
      "source": "second",
      "target": "check_second"
    },
    {
      "id": "e-check_second-end",
      "source": "check_second",
      "target": "end"
    }
  ],
  "policy": {
    "approval_for_external_writes": true,
    "max_run_duration_s": 3600,
    "run_as": "initiator"
  },
  "layout": {
    "positions": {
      "trigger": {
        "x": 200,
        "y": 0
      },
      "first": {
        "x": 200,
        "y": 116
      },
      "check_first": {
        "x": 200,
        "y": 232
      },
      "sufficient": {
        "x": 200,
        "y": 348
      },
      "second": {
        "x": 480,
        "y": 464
      },
      "check_second": {
        "x": 480,
        "y": 580
      },
      "end": {
        "x": 200,
        "y": 696
      }
    }
  },
  "governance": {
    "state": "approved"
  },
  "created_by": "pack:nexus-base",
  "created_at": "2026-09-17T12:00:00Z",
  "published_at": "2026-09-17T12:00:00Z"
}
