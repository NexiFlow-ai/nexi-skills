      "target": "join"
    },
    {
      "id": "e-join-combine",
      "source": "join",
      "target": "combine"
    },
    {
      "id": "e-combine-end",
      "source": "combine",
      "target": "end"
    }
  ],
  "policy": {
    "approval_for_external_writes": true,
    "max_run_duration_s": 3600,
