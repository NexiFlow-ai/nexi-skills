{
  "blueprint_id": "nexus-base",
  "uri": "nexus://core/blueprint/nexus-base",
  "name": "Nexi Base",
  "description": "The base layer every organization starts from: generic, vendor-free, human-reviewed skills, agents, flow templates, platform tools, connector kinds, model roles and sandbox profiles. Child layers (organization, project) may only tighten it.",
  "layer": "base",
  "version": "1.12.0",
  "status": "published",
  "source_pack_uri": "nexus://core/pack/nexus-base",
  "deployment_targets": [
    "on_prem",
    "azure",
    "disconnected"
  ],
  "defaults": {
    "agents": [
      "nexus://agent/agt_general",
      "nexus://agent/agt_analyst",
      "nexus://agent/agt_writer",
