{
  "uri": "nexus://bi/template/nexus_vibeban",
  "id": "nexus_vibeban",
  "title": [
    {
      "text": "Vibeban work",
      "lang": "en"
    },
    {
      "text": "Робота у Vibeban",
      "lang": "uk"
    }
  ],
  "decision_kinds": [
    "delivery_review",
    "unblock_work"
  ],
  "platform": true,
  "pack_ref": "nexus://core/pack/nexus-base",
  "version": "1.0.0",
  "slots": [
    {
      "id": "sec_flow",
      "kind": "section",
      "role": "flow_of_work",
      "required": true,
      "recommended_size": {
        "w": 12,
        "h": 1
      }
    },
    {
      "id": "items_open",
      "kind": "metric",
      "role": "volume",
      "required": true,
      "recommended_size": {
        "w": 3,
        "h": 2
      },
      "metric_key": "work_items_open",
      "metric_hint": "volume"
    },
    {
      "id": "blocked",
      "kind": "metric",
      "role": "risk",
      "required": true,
      "recommended_size": {
        "w": 3,
        "h": 2
      },
      "metric_key": "work_items_blocked",
      "metric_hint": "risk"
    },
    {
      "id": "overdue",
      "kind": "metric",
      "role": "risk",
      "required": true,
      "recommended_size": {
        "w": 3,
        "h": 2
      },
      "metric_key": "work_items_overdue"
    },
    {
      "id": "items_done",
      "kind": "metric",
      "role": "outcome",
      "required": true,
      "recommended_size": {
        "w": 3,
        "h": 2
      },
      "metric_key": "work_items_done",
      "metric_hint": "outcome"
    },
    {
      "id": "progress",
      "kind": "metric",
      "role": "outcome",
      "required": true,
      "recommended_size": {
        "w": 3,
        "h": 2
      },
      "metric_key": "work_progress_pct",
      "metric_hint": "outcome"
    },
    {
      "id": "due_soon",
      "kind": "metric",
      "role": "risk",
      "required": false,
      "recommended_size": {
        "w": 3,
        "h": 2
      },
      "metric_key": "work_items_due_soon"
    },
    {
      "id": "done_trend",
      "kind": "chart",
      "role": "trend_over_days",
      "required": false,
      "recommended_size": {
        "w": 6,
        "h": 4
      },
      "metric_key": "work_items_done_history",
      "metric_hint": "outcome"
    },
    {
      "id": "open_trend",
      "kind": "chart",
      "role": "trend_over_days",
      "required": false,
      "recommended_size": {
        "w": 6,
        "h": 4
      },
      "metric_key": "work_items_open_history",
      "metric_hint": "outcome"
    },
    {
      "id": "sec_approvals",
      "kind": "section",
      "role": "approvals_and_decisions",
      "required": true,
      "recommended_size": {
        "w": 12,
        "h": 1
      }
    },
    {
      "id": "dashboards",
      "kind": "metric",
      "role": "volume",
      "required": false,
      "recommended_size": {
        "w": 3,
        "h": 2
      },
      "metric_key": "bi_dashboards_total"
    },
    {
      "id": "blocked_trend",
      "kind": "chart",
      "role": "trend_over_days",
      "required": false,
      "recommended_size": {
        "w": 12,
        "h": 4
      },
      "metric_key": "work_items_blocked_history",
      "metric_hint": "outcome"
    },
    {
      "id": "ready",
      "kind": "text",
      "role": "ready_when_tasks_reports",
      "required": false,
      "recommended_size": {
        "w": 4,
        "h": 2
      }
    }
  ]
}
